<% content_for :title, "Flip 7" %>

<div class="hero min-h-screen bg-base-200">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">Flip 7</h1>
      <p class="py-6">The push-your-luck card game — now multiplayer.</p>

      <div class="flex flex-col gap-3">
        <%= link_to "Play Solo", "/play/solo", class: "btn btn-primary btn-lg" %>
        <%= link_to "Pass & Play", "/play/local", class: "btn btn-outline btn-lg" %>
        <%= link_to "Join Casual", "/play/casual", class: "btn btn-secondary btn-lg" %>
        <%= link_to "Ranked Duel", "/play/ranked", class: "btn btn-accent btn-lg" %>
      </div>

      <div class="divider">or</div>

      <% if user_signed_in? %>
        <p>Welcome, <strong><%= current_user.name.presence || current_user.email %></strong></p>
        <%= link_to "My Profile", my_profile_path, class: "btn btn-outline btn-sm mt-2" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
      <% else %>
        <%= button_to "Sign in with Google",
            user_google_oauth2_omniauth_authorize_path,
            method: :post,
            data: { turbo: false },
            class: "btn btn-outline w-full" %>
      <% end %>
    </div>
  </div>
</div>
