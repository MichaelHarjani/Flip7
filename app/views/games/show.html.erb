<% content_for :title, @game.in_progress? ? "Flip 7 — In Progress" : "Waiting Room" %>

<% if @game.waiting? %>
  <div class="hero min-h-screen bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-4xl font-bold">Waiting room: <%= @game.room_code || "—" %></h1>
        <p class="py-4">Mode: <strong><%= @game.mode %></strong> · Status: <strong><%= @game.status %></strong></p>

        <% if @game.room_code.present? %>
          <div class="card bg-base-100 shadow-md mb-4">
            <div class="card-body">
              <h2 class="card-title">Share this code</h2>
              <p class="text-3xl font-mono tracking-widest"><%= @game.room_code %></p>
              <p class="text-sm opacity-70">Friends can join at <code>/join</code></p>
            </div>
          </div>
        <% end %>

        <div class="card bg-base-100 shadow-md mb-4">
          <div class="card-body">
            <h2 class="card-title">Players (<%= @game.game_players.count %>)</h2>
            <ul class="list-none">
              <% @game.game_players.order(:seat_position).each do |gp| %>
                <li>Seat <%= gp.seat_position %> — <%= gp.user&.name.presence || gp.user&.email || "Bot" %></li>
              <% end %>
            </ul>
          </div>
        </div>

        <%= link_to "Back home", root_path, class: "btn btn-outline btn-sm" %>
      </div>
    </div>
  </div>
<% elsif @game.in_progress? %>
  <%
    round_state = @game.round_state || {}
    player_hands = round_state["player_hands"] || {}
    player_statuses = round_state["player_statuses"] || {}
    cumulative = @game.cumulative_scores || {}
    ordered_players = @game.game_players.includes(:user).order(:seat_position).to_a
    current_idx = @game.current_turn_player_index
    current_player = current_idx ? ordered_players[current_idx % ordered_players.size] : nil
    is_current_user_turn = user_signed_in? && current_player && current_player.user_id == current_user.id
    pending_action = round_state["pending_action"]
  %>

  <div class="min-h-screen bg-base-200 p-6">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold">Flip 7 — Round <%= @game.current_round %></h1>
          <p class="text-sm opacity-70">Mode: <strong><%= @game.mode %></strong></p>
        </div>
        <%= link_to "Home", root_path, class: "btn btn-ghost btn-sm" %>
      </div>

      <% if current_player %>
        <div class="alert <%= is_current_user_turn ? 'alert-success' : 'alert-info' %> mb-4">
          <span>
            Current turn: <strong><%= current_player.user&.name.presence || current_player.user&.email || "Bot" %></strong>
            <% if is_current_user_turn %> — Your move!<% end %>
          </span>
        </div>
      <% end %>

      <% if pending_action %>
        <div class="alert alert-warning mb-4">
          <span>Pending action: <strong><%= pending_action["type"] %></strong> by player #<%= pending_action["drawer_id"] %></span>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% ordered_players.each do |gp| %>
          <%
            uid = gp.user_id.to_s
            hand = player_hands[uid] || {}
            number_cards = Array(hand["number_cards"])
            modifiers = Array(hand["modifiers"])
            has_second_chance = hand["has_second_chance"]
            status = player_statuses[uid] || "active"
            cum_score = cumulative[uid].to_i
            is_me = user_signed_in? && gp.user_id == current_user.id
            is_active_turn = current_player && current_player.id == gp.id
          %>
          <div class="card bg-base-100 shadow-md <%= 'ring-2 ring-primary' if is_active_turn %>">
            <div class="card-body">
              <div class="flex items-center justify-between">
                <h2 class="card-title">
                  Seat <%= gp.seat_position %> — <%= gp.user&.name.presence || gp.user&.email || "Bot" %>
                  <% if gp.is_bot %><span class="badge badge-secondary badge-sm">BOT</span><% end %>
                  <% if is_me %><span class="badge badge-primary badge-sm">YOU</span><% end %>
                </h2>
                <span class="text-2xl font-bold"><%= cum_score %></span>
              </div>

              <div class="my-2">
                <% if status == "busted" %>
                  <span class="badge badge-error">Busted</span>
                <% elsif status == "stayed" %>
                  <span class="badge badge-success">Stayed</span>
                <% else %>
                  <span class="badge badge-info">Active</span>
                <% end %>
                <% if has_second_chance %>
                  <span class="badge badge-warning">2nd chance</span>
                <% end %>
              </div>

              <div class="flex flex-wrap gap-2">
                <% number_cards.each do |v| %>
                  <span class="badge badge-lg badge-outline"><%= v %></span>
                <% end %>
                <% modifiers.each do |m| %>
                  <% label = m["modifier"] == "times" ? "x#{m["value"]}" : "+#{m["value"]}" %>
                  <span class="badge badge-lg badge-accent"><%= label %></span>
                <% end %>
                <% if number_cards.empty? && modifiers.empty? %>
                  <span class="text-xs opacity-50">No cards yet.</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if is_current_user_turn && !pending_action %>
        <div class="flex gap-3 justify-center mt-6">
          <%= button_to "Hit",
              hit_game_moves_path(@game),
              method: :post,
              class: "btn btn-primary btn-lg",
              form: { data: { turbo: false } } %>
          <%= button_to "Stay",
              stay_game_moves_path(@game),
              method: :post,
              class: "btn btn-secondary btn-lg",
              form: { data: { turbo: false } } %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="hero min-h-screen bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-4xl font-bold">Game <%= @game.status.humanize %></h1>
        <p class="py-4">Final scores</p>
        <div class="card bg-base-100 shadow-md mb-4">
          <div class="card-body">
            <ul class="list-none">
              <% @game.game_players.includes(:user).order(:seat_position).each do |gp| %>
                <li>
                  <%= gp.user&.name.presence || gp.user&.email || "Bot" %> —
                  <strong><%= (@game.cumulative_scores || {})[gp.user_id.to_s].to_i %></strong>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
        <%= link_to "Back home", root_path, class: "btn btn-outline btn-sm" %>
      </div>
    </div>
  </div>
<% end %>
