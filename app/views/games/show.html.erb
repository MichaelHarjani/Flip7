<% content_for :title, @game.in_progress? ? "Flip 7 — Round #{@game.current_round}" : "Flip 7" %>
<%# Live updates: every engine save broadcasts a refresh; the page morphs in place. %>
<%= turbo_stream_from @game %>

<% if @game.waiting? %>
  <%= render "games/lobby", game: @game, board: @board %>
<% elsif @game.in_progress? %>
  <%= render "games/board", game: @game, board: @board %>
<% else %>
  <%= render "games/game_over", game: @game, board: @board %>
<% end %>
