<% content_for :title, "Waiting Room" %>

<div class="hero min-h-screen bg-base-200">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-4xl font-bold">Waiting room: <%= @game.room_code || "—" %></h1>
      <p class="py-4">Mode: <strong><%= @game.mode %></strong> · Status: <strong><%= @game.status %></strong></p>

      <% if @game.room_code.present? %>
        <div class="card bg-base-100 shadow-md mb-4">
          <div class="card-body">
            <h2 class="card-title">Share this code</h2>
            <p class="text-3xl font-mono tracking-widest"><%= @game.room_code %></p>
            <p class="text-sm opacity-70">Friends can join at <code>/join</code></p>
          </div>
        </div>
      <% end %>

      <div class="card bg-base-100 shadow-md mb-4">
        <div class="card-body">
          <h2 class="card-title">Players (<%= @game.game_players.count %>)</h2>
          <ul class="list-none">
            <% @game.game_players.order(:seat_position).each do |gp| %>
              <li>Seat <%= gp.seat_position %> — <%= gp.user&.name.presence || gp.user&.email || "Bot" %></li>
            <% end %>
          </ul>
        </div>
      </div>

      <%= link_to "Back home", root_path, class: "btn btn-outline btn-sm" %>
    </div>
  </div>
</div>
